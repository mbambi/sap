{
  "name": "sap-erp-learning-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Web-based ERP learning platform for university students",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "php -S localhost:8080 -t .",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "db:seed": "php seed.php",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
